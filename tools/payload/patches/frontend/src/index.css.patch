+/* Inputs and selects always use base-100 background so they stay readable
+   on any parent background (cards, modals, darker sections) */
+.input,
+.select,
+textarea.textarea {
+  background-color: var(--color-base-100);
+}
+
+/* shadcn Dialog uses `bg-background` (a CSS variable utility) which doesn't
+   reliably resolve under Tailwind v4 + DaisyUI without `@theme` setup. Force
+   solid DaisyUI base-100 on every dialog content panel so stacked dialogs
+   (modal-on-modal) don't show through to the parent. */
+[data-slot="dialog-content"] {
+  background-color: var(--color-base-100) !important;
+}
+[data-slot="dialog-overlay"] {
+  /* Make the second overlay slightly stronger so the boundary between
+     stacked dialogs is visually obvious. */
+  background-color: rgb(0 0 0 / 0.55) !important;
+}
+
+/* Placeholders should look distinctly "ghosty" — italic + much lighter
+   than real values — so the user can tell at a glance whether a field has
+   been filled in or still shows a hint. */
+.input::placeholder,
+.select::placeholder,
+textarea.textarea::placeholder,
+input::placeholder,
+textarea::placeholder {
+  color: color-mix(in oklab, var(--color-base-content) 50%, transparent);
+  font-style: italic;
+  opacity: 1; /* normalise across browsers */
+}
